{
  "name": "agentproxy",
  "version": "2.4.6",
  "description": "OpenAI-compatible HTTP service backed by cursor-agent.",
  "type": "module",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "serve": "node dist/server/main.js",
    "docker:publish": "scripts/deploy-ghcr.sh",
    "test": "npm run build && node --test tests/openai-service.test.mjs",
    "test:unit": "npm test",
    "test:integration": "npm test",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "agentproxy": "dist/server/main.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "import": "./dist/server/openai.js",
      "default": "./dist/server/openai.js"
    },
    "./lib": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nomadcxx/opencode-cursor.git"
  },
  "homepage": "https://github.com/Nomadcxx/opencode-cursor#readme",
  "bugs": {
    "url": "https://github.com/Nomadcxx/opencode-cursor/issues"
  },
  "keywords": [
    "cursor",
    "cursor-agent",
    "openai-compatible",
    "ai",
    "streaming"
  ],
  "author": "Nomadcxx"
}
